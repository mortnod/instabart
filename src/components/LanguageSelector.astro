---
import { languages, getLangFromUrl, getLocalizedUrl, useTranslations } from '../i18n/utils';
import IconGlobe from './icons/IconGlobe.astro';
import ButtonFooter from './button/ButtonFooter.astro';

interface Props {
  id: string;
  iconOnly?: boolean;
  side?: 'top' | 'bottom';
}

const { id, iconOnly = false, side = 'top' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const popoverId = `${id}-popover`;
const anchorName = `--${id}`;
---

<ButtonFooter
  id={id}
  iconOnly={iconOnly}
  type="button"
  popovertarget={popoverId}
  style={`anchor-name: ${anchorName}`}
  aria-label={`${t('language.select')}: ${languages[currentLang]}`}
>
  <IconGlobe />
  <span class:list={{ 'sr-only': iconOnly }}>{languages[currentLang]}</span>
</ButtonFooter>

<ul
  id={popoverId}
  popover="auto"
  data-side={side}
  style={`position-anchor: ${anchorName}`}
  aria-label={t('language.select')}
  class="language-popover w-48 max-w-[calc(100vw-1rem)] list-none rounded-2xl border border-gray-200 bg-white p-1.5 text-base text-gray-900 shadow-lg dark:border-slate-700 dark:bg-slate-800 dark:text-blue-200"
>
  {Object.entries(languages).map(([lang, name]) => (
    <li>
      <a
        href={getLocalizedUrl(Astro.url.pathname, lang as keyof typeof languages, currentLang)}
        lang={lang}
        hreflang={lang}
        aria-current={lang === currentLang ? 'page' : undefined}
        class:list={[
          'flex min-h-11 items-center justify-between gap-4 rounded-xl px-3 py-2 no-underline outline-none hover:bg-gray-100 focus-visible:shadow-card-ring dark:hover:bg-slate-700/50',
          { 'bg-gray-100 font-bold dark:bg-slate-700/50': lang === currentLang },
        ]}
      >
        {name}
        {lang === currentLang && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="m5 12 4 4L19 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  /* Browsers without anchor positioning use the native centered popover. */
  @supports (position-anchor: --language) {
    .language-popover {
      position: fixed;
      inset: auto;
      margin: 0;
      position-visibility: anchors-visible;
    }

    .language-popover[data-side='bottom'] {
      top: calc(anchor(bottom) + 0.5rem);
      right: anchor(right);
    }

    .language-popover[data-side='top'] {
      bottom: calc(anchor(top) + 0.5rem);
      left: anchor(left);
    }
  }
</style>
