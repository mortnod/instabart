---
import ButtonFooter from './button/ButtonFooter.astro';
// import IconComputer from './icons/IconComputer.astro';
import IconMoon from './icons/IconMoon.astro';
import IconSun from './icons/IconSun.astro';
import { useTranslations, getLangFromUrl } from '../i18n/utils';

interface Props {
  iconOnly?: boolean;
}

const { iconOnly = false } = Astro.props;
const idPrefix = iconOnly ? 'header-' : '';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ButtonFooter id={`${idPrefix}themeSelectDark`} data-theme="dark" type="button" className={`inline-flex dark:hidden ${iconOnly ? "!px-2" : ""}`}>
  <IconMoon />
  <span class:list={{ 'sr-only': iconOnly }}>{t('theme.dark')}</span>
</ButtonFooter>

<ButtonFooter id={`${idPrefix}themeSelectLight`} data-theme="light" type="button" className={`hidden dark:inline-flex ${iconOnly ? "!px-2" : ""}`}>
  <IconSun />
  <span class:list={{ 'sr-only': iconOnly }}>{t('theme.light')}</span>
</ButtonFooter>

<!-- <ButtonFooter id="themeSelectSystem">
  <IconComputer />
  {t('theme.system')}
</ButtonFooter> -->

<script>
  const onThemeChange = () => {
    const isDark =
      localStorage.theme === 'dark' ||
      (!('theme' in localStorage) &&
        window.matchMedia('(prefers-color-scheme: dark)').matches);

    if (isDark) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  };

  document.querySelectorAll<HTMLButtonElement>('button[data-theme]').forEach((button) => {
    button.addEventListener('click', () => {
      localStorage.theme = button.dataset.theme!;
      onThemeChange();
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', onThemeChange);
</script>
